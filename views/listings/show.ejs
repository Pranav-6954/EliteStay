<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-12 col-md-10 col-lg-8">

            <!-- Listing Card -->
            <div class="card show-card shadow-sm">
                <div class="card-body">

                    <h3 class="mb-3"><%= listing.title %></h3>

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top show-img mb-3"
                        alt="listing_image">
                    
                    <p class="card-text">Owned By
                      <i><%= (listing.owner && listing.owner.username) ? listing.owner.username : "EliteStay Host" %></i>
                    </p>

                    <p class="card-text">
                        <%= listing.description %>
                    </p>

                    <p class="card-text">
                        <strong>Price:</strong>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %>
                    </p>

                    <p class="card-text">
                        <strong>Location:</strong>
                        <%= listing.location %>,
                        <%= listing.country %>
                    </p>

                </div>
            </div>

            <% 
              const currentUser = (typeof currUser !== "undefined" && currUser) ? currUser : (typeof locals !== "undefined" && locals.currUser ? locals.currUser : null);
              const currUserId = currentUser ? (currentUser._id ? currentUser._id.toString() : currentUser.toString()) : null;
              const ownerId = listing.owner ? (listing.owner._id ? listing.owner._id.toString() : listing.owner.toString()) : null;
              const isDummyOwner = !ownerId || ownerId === "6a620bfb3e13a663d1e04600";
              const canEdit = currentUser && (isDummyOwner || ownerId === currUserId);
            %>
            <% if(canEdit) { %>
            <!-- Buttons -->
            <div class="btns mt-3 mb-4">
                <a href="/listings/<%= listing._id %>/edit"
                    class="btn btn-danger edit-btn">
                    Edit
                </a>

                <form
                    method="POST"
                    action="/listings/<%= listing._id %>?_method=DELETE">

                    <button class="btn btn-dark">
                        Delete
                    </button>

                </form>
            </div>
            <hr>
            <% } %>
            

            <!-- Review Form -->
             <% if(currentUser) { %>
            <h4 class="mb-3">Leave a Review</h4>

            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
                novalidate
                class="needs-validation">

                
                <div class="mb-3">
                <label for="rating" class="form-label">Rating</label>
                
                <fieldset class="starability-slot">
                <input 
                    type="radio" 
                    id="no-rate" 
                    class="input-no-rate" 
                    name="review[rating]" 
                    value="1" 
                    checked aria-label="No rating." 
                />
                <input 
                    type="radio" 
                    id="first-rate1" 
                    name="review[rating]" 
                    value="1" 
                />

                <label for="first-rate1" title="Terrible">1 star</label>
                <input 
                    type="radio" 
                    id="first-rate2" 
                    name="review[rating]" 
                    value="2" 
                />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" 
                    id="first-rate3" 
                    name="review[rating]" 
                    value="3" 
                />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" 
                    id="first-rate4" 
                    name="review[rating]" 
                    value="4" 
                />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" 
                    id="first-rate5" 
                    name="review[rating]" 
                    value="5" 
                />
                <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
                </div>
                <div class="mb-3">

                    <label for="comment" class="form-label">
                        Comments
                    </label>

                    <textarea
                        name="review[comment]"
                        id="comment"
                        rows="5"
                        class="form-control"
                        required></textarea>

                    <div class="invalid-feedback">
                        Please add some comments.
                    </div>

                </div>

                <button class="btn btn-outline-dark">
                    Submit
                </button>

            </form>
            <% } %>
            <hr>

            <!-- Reviews -->
            <h4 class="mb-3">All Reviews</h4>

            <div class="row">

                <% for(let review of listing.reviews) { %>

                <div class="col-12 col-md-6 mb-3">

                    <div class="card border border-dark h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                @<%= review.author.username %>
                            </h5>

                            <p class="starability-result card-text" 
                                data-rating="3">
                                <%= review.rating %>
                            </p>

                            <p class="card-text">
                                <%= review.comment %>
                            </p>

                            

                        </div>

                        <div class="card-footer bg-white border-0">

                            <form
                                method="POST"
                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                                <button class="btn btn-sm btn-dark">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

                <% } %>

            </div>

            <hr>
            <h3>Where you'll be</h3>
            <div id="map"
                 data-lat="<%= (listing.geometry && listing.geometry.lat) ? listing.geometry.lat : 0 %>"
                 data-lng="<%= (listing.geometry && listing.geometry.lng) ? listing.geometry.lng : 0 %>"
                 data-title="<%= listing.title %>"
                 data-location="<%= listing.location %>"
                 data-country="<%= listing.country %>">
            </div>

            </div>

        </div>

    </div>

</div>

<script src="/js/map.js"></script>