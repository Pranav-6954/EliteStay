<style>
  .btn-search{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem 0;
  }

  .btn-search:hover{
    background-color: #fe424d;
    color: #fff;
  }

  .btn-search i{
    display: inline;
    margin-right: 0.5rem;
    padding: 0.5rem 3rem 0.5rem 3 rem;
  }

  .search-input{
    border-radius: 25px;
  }
</style>

<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top shadow-sm">
  <div class="container">

    <a class="navbar-brand" href="/listings">
      <i class="fa-brands fa-asymmetrik"></i> EliteStay
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation">

      <span class="navbar-toggler-icon"></span>

    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
        
      </div>

      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
          <input class="form-control me-2 search-input" type="search" placeholder="Search destinations" aria-label="Search"/>
          <button class="btn btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
        </form>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">EliteStay your home</a>
        <% const currentUser = (typeof currUser !== "undefined" && currUser) ? currUser : (typeof locals !== "undefined" && locals.currUser ? locals.currUser : null); %>
        <% if(!currentUser) { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <% } else { %>
          <a class="nav-link" href="/logout"><b>Log Out</b></a>
        <% } %>
      </div>

    </div>

  </div>
</nav>